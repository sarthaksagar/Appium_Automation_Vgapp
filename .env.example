# Copy this file to '.env' (untracked by Git) and populate with authorized QA credentials.
# Never commit '.env' or live credentials into source control.

# Patient Role QA Account
QA_PATIENT_EMAIL=
QA_PATIENT_PASSWORD=

# Doctor Role QA Account
QA_DOCTOR_EMAIL=
QA_DOCTOR_PASSWORD=

# Optional Controlled QA Mailbox / Synthetic Domain
QA_RESET_EMAIL=qa-reset@example.invalid
QA_SIGNUP_EMAIL_DOMAIN=example.invalid

# Optional Multi-Device / Explicit UDID Override
# VGCARES_UDID=
