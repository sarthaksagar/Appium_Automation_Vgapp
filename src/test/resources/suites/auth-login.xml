<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  ╔══════════════════════════════════════════════════════════════════════╗
  ║  VGCares Global – Authentication Suite (Patient & Doctor Login)      ║
  ║  Run cmd : mvn test -DsuiteXmlFile=src/test/resources/suites/auth-login.xml ║
  ╚══════════════════════════════════════════════════════════════════════╝
-->

<suite name="VGCares Patient and Doctor Login Suite" verbose="2" parallel="none" configfailurepolicy="skip">

    <test name="Patient and Doctor Authentication - Real Android Device" preserve-order="true">
        <classes>
            <class name="com.vgcares.automation.tests.launch.LaunchTest" />
            <class name="com.vgcares.automation.tests.auth.SignUpTest" />
            <class name="com.vgcares.automation.tests.auth.LoginTest" />
            <class name="com.vgcares.automation.tests.auth.DoctorLoginTest" />
            <class name="com.vgcares.automation.tests.auth.DynamicLiveLoginTest" />
            <class name="com.vgcares.automation.tests.auth.ForgotPasswordTest" />
        </classes>
    </test>

</suite>
