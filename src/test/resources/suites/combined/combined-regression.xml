<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="VGCares Combined Regression Suite" verbose="2" parallel="none" configfailurepolicy="skip">

    <!-- Phase 1: Common & Patient Role Regression (sequential on single physical device) -->
