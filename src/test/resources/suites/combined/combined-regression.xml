            <class name="com.vgcares.automation.tests.messages.MessagesNegativeTest" />
            <class name="com.vgcares.automation.tests.profile.ProfileNavigationAndHeaderTest" />
            <class name="com.vgcares.automation.tests.profile.ProfileFormsAndValidationTest" />
